# S2S serverless worker: env for running the worker OUTSIDE docker on runpod2 with the existing DEP1 venvs and assets.
# Sourced by worker/local/run_local.sh. This directory is the ONLY place in worker/ that names runpod2 paths
# (DESIGN Amendment W: exempt from the path-grep rule; it is excluded from the image by Dockerfile.dockerignore).
# Ports are moved off the live DEP1 demo (8995/8996/8998/8999).
S2S_ROOT=/root/deploy_serverless
S2S_PY_PP=/root/deploy/venv-pp/bin/python
S2S_PY_ASR=/root/deploy/venv-asr/bin/python
S2S_PY_NEEDLE=/root/deploy_serverless/.venvs/needle/bin/python
S2S_PY_RP=/root/deploy_serverless/.venvs/rp/bin/python
S2S_ADAPTER=/root/deploy/assets/ws/runs/V3_A/checkpoints/checkpoint_000200/consolidated
S2S_NEEDLE_WEIGHTS=/root/needle/finetune/sweep/tuned_full.cact
S2S_PP_DIR=/root/hf/hub/models--nvidia--personaplex-7b-v1/snapshots/fdaf4090a61cb315c138a1faee287ffd6c716309
S2S_ASR_HF_HOME=/root/hf
S2S_MOCK_REPLAY=/workspace/hinglish/tests/out/V3_A/V3
S2S_MOCK_INPUTS=/workspace/hinglish/tests/inputs/V3
S2S_TMP=/tmp/s2s-local
S2S_LOGS=/tmp/s2s-local/logs
PORT=18000
S2S_INTERNAL_PORT=18999
S2S_ASR_PORT=18996
S2S_ROUTER_PORT=18995
PYTHONDONTWRITEBYTECODE=1
