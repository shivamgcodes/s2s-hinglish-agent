# S2S serverless worker: env for CPU mock tests on pod1 (copy of runpod2.env, paths moved to /root/dep2; 2026-10-06).
# Read by worker/tests/test_worker_mock.py when S2S_LOCAL_ENV points here. Ports stay off the live demo (899x).
S2S_ROOT=/root/dep2
S2S_PY_PP=/root/deploy/venv-pp/bin/python
S2S_PY_ASR=/root/deploy/venv-asr/bin/python
S2S_PY_NEEDLE=/root/dep2/.venvs/needle/bin/python
S2S_PY_RP=/root/dep2/.venvs/rp/bin/python
S2S_ADAPTER=/root/deploy/assets/adapters/V4_A2_600
S2S_NEEDLE_WEIGHTS=/root/needle/finetune/sweep/tuned_full.cact
S2S_PP_DIR=/root/hf/hub/models--nvidia--personaplex-7b-v1/snapshots/fdaf4090a61cb315c138a1faee287ffd6c716309
S2S_ASR_HF_HOME=/root/hf
S2S_MOCK_REPLAY=/workspace/hinglish/tests/out/V3_A/V3
S2S_MOCK_INPUTS=/workspace/hinglish/tests/inputs/V3
S2S_TMP=/tmp/s2s-local
S2S_LOGS=/tmp/s2s-local/logs
PORT=18000
S2S_INTERNAL_PORT=18999
S2S_ASR_PORT=18996
S2S_ROUTER_PORT=18995
PYTHONDONTWRITEBYTECODE=1
