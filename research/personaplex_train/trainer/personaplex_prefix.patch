+def get_fsdp_model(args: TrainArgs, moshi_weight: str) -> LMModel:
+    """PersonaPlex version: loads nvidia/personaplex-7b-v1 with the PersonaPlex moshi loaders
+    (moshi.models.loaders.get_moshi_lm, dep_q=16), then adds weight-level LoRA (finetune/pp_lora.py),
+    freezes per moshi-finetune's rules and wraps every layer in activation checkpointing.
+    Single GPU only (PersonaPlex has no FSDP-ready meta init path here)."""
+    assert get_world_size() == 1, "PersonaPlex patch supports a single GPU only"
+    assert args.lora.enable and not args.full_finetuning, "PersonaPlex patch supports LoRA only"
+    param_dtype = getattr(torch, args.param_dtype)
+
+    model = loaders.get_moshi_lm(moshi_weight, device="cuda", dtype=param_dtype)
+    assert model.dep_q == 16 and model.n_q == 16, (model.dep_q, model.n_q)
+
+    logger.info("Adding weight-level LoRA ...")
+    names = pp_lora.apply_lora(model, args.lora.rank, args.lora.scaling, dep_steps=args.dep_train_steps)
+    logger.info(f"LoRA on {len(names)} weights (rank {args.lora.rank}, scaling {args.lora.scaling})")
+    pp_lora.set_trainable(model, args.lora.ft_embed, args.dep_train_steps)
+    if args.gradient_checkpointing:
+        pp_lora.enable_activation_checkpointing(model)
+    assert all(p.dtype == param_dtype for p in model.parameters())
+    log_train_params(model)
+    return model
