+"""PersonaPlex support for moshi-finetune: weight-level LoRA, activation checkpointing,
+an agent-only forward pass, the masked loss, and adapter save.
+
+PersonaPlex (moshi fork at /workspace/personaplex/moshi) reads several weights functionally
+(self_attn.in_proj_weight via F.linear / multi_linear, depformer out_proj.weight via multi_linear,
+gating linear_in/linear_out .weight via gating_forward_kernel), so moshi's module-swap LoRALinear
+cannot be used. Instead every target weight W gets a torch parametrization W_eff = W + s * B @ A.
+Parameter names stay PersonaPlex's own, which is what the adapter file is keyed by.
+
+Stacked per-step depformer weights ([n_steps*out, in]) get one LoRA pair per step (A:[n,r,in],
+B:[n,out,r]), the same semantics as upstream moshi's per-step in_projs/out_projs.
+
+Only the first `dep_steps` (=8) depformer steps are run in training: those produce the 8 agent
+codebooks (rows 1-8). The depformer is causal over steps, so their logits are identical to the
+full 16-step pass; steps 8-15 (user codebooks) never enter the loss, so they get no LoRA.
+"""
+import math
+
+import torch
+from torch import nn
+from torch.nn.utils import parametrize
+from torch.utils.checkpoint import checkpoint
+
+from moshi.models.lm import LMOutput, _delay_sequence, _undelay_sequence
+
+ADAPTER_FORMAT = "personaplex_weight_lora_v1"
+
+
+class LoRAWeight(nn.Module):
+    """Parametrization W -> W + scaling * B @ A, per block for stacked per-step weights.
+
+    W has shape [n_blocks * out_f, in_f]; only the first n_active blocks are adapted.
+    A: [n_active, rank, in_f] (kaiming-uniform, as moshi-finetune), B: [n_active, out_f, rank] (zeros).
+    """
+
+    def __init__(self, out_f, in_f, rank, scaling, n_blocks=1, n_active=1, device=None, dtype=None):
+        super().__init__()
+        self.out_f, self.in_f = out_f, in_f
+        self.n_blocks, self.n_active = n_blocks, n_active
+        self.scaling = scaling
+        self.lora_A = nn.Parameter(torch.empty(n_active, rank, in_f, device=device, dtype=dtype))
+        self.lora_B = nn.Parameter(torch.zeros(n_active, out_f, rank, device=device, dtype=dtype))
+        with torch.no_grad():
+            for i in range(n_active):
+                nn.init.kaiming_uniform_(self.lora_A[i], a=math.sqrt(5))
+
+    def delta(self):
+        return torch.bmm(self.lora_B, self.lora_A) * self.scaling  # [n_active, out_f, in_f]
+
+    def forward(self, W):
+        d = self.delta().to(W.dtype)
+        if self.n_active == self.n_blocks:
+            return W + d.reshape(W.shape)
+        Wv = W.view(self.n_blocks, self.out_f, self.in_f)
+        return torch.cat([Wv[: self.n_active] + d, Wv[self.n_active:]], 0).reshape(W.shape)
+
+
+def lora_targets(lm, dep_steps: int = 8):
+    """All linear weights of the temporal transformer and the depformer (first dep_steps steps),
+    plus depformer_in / linears (first dep_steps) and text_linear.
+    Returns [(pp_param_name, module, attr, n_blocks, n_active)]."""
+    out = []
+    for i, layer in enumerate(lm.transformer.layers):
+        p = f"transformer.layers.{i}"
+        out += [(f"{p}.self_attn.in_proj_weight", layer.self_attn, "in_proj_weight", 1, 1),
+                (f"{p}.self_attn.out_proj.weight", layer.self_attn.out_proj, "weight", 1, 1),
+                (f"{p}.gating.linear_in.weight", layer.gating.linear_in, "weight", 1, 1),
+                (f"{p}.gating.linear_out.weight", layer.gating.linear_out, "weight", 1, 1)]
+    n_dep = lm.dep_q
+    for i, layer in enumerate(lm.depformer.layers):
+        p = f"depformer.layers.{i}"
+        assert layer.self_attn.weights_per_step == n_dep, "expected per-step depformer weights"
+        out += [(f"{p}.self_attn.in_proj_weight", layer.self_attn, "in_proj_weight", n_dep, dep_steps),
+                (f"{p}.self_attn.out_proj.weight", layer.self_attn.out_proj, "weight", n_dep, dep_steps)]
+        for s in range(dep_steps):
+            g = layer.gating[s]
+            out += [(f"{p}.gating.{s}.linear_in.weight", g.linear_in, "weight", 1, 1),
+                    (f"{p}.gating.{s}.linear_out.weight", g.linear_out, "weight", 1, 1)]
+    assert lm.depformer_multi_linear and lm.depformer_weights_per_step_schedule is None
+    for s in range(dep_steps):
+        out.append((f"depformer_in.{s}.weight", lm.depformer_in[s], "weight", 1, 1))
+        out.append((f"linears.{s}.weight", lm.linears[s], "weight", 1, 1))
+    out.append(("text_linear.weight", lm.text_linear, "weight", 1, 1))
+    return out
+
+
+def apply_lora(lm, rank: int, scaling: float, dep_steps: int = 8) -> list[str]:
+    names = []
+    for name, mod, attr, nb, na in lora_targets(lm, dep_steps):
+        W = getattr(mod, attr)
+        assert W.shape[0] % nb == 0, name
+        par = LoRAWeight(W.shape[0] // nb, W.shape[1], rank, scaling, nb, na, device=W.device, dtype=W.dtype)
+        parametrize.register_parametrization(mod, attr, par)
+        names.append(name)
+    return names
+
+
+def is_trainable_emb(name: str, dep_steps: int) -> bool:
+    """Embedding tables trained when lora.ft_embed (moshi-finetune rule: 'emb' in name), restricted to
+    the depformer embeddings the dep_steps forward actually uses."""
+    if name.startswith("emb.") or name.startswith("text_emb.") or name.startswith("depformer_text_emb."):
+        return True
+    if name.startswith("depformer_emb."):
+        return int(name.split(".")[1]) < dep_steps - 1
+    return False
+
+
+def set_trainable(lm, ft_embed: bool, dep_steps: int):
+    for n, p in lm.named_parameters():
+        p.requires_grad = ("lora_A" in n or "lora_B" in n) or (ft_embed and is_trainable_emb(n, dep_steps))
+
+
+def enable_activation_checkpointing(lm):
+    """PersonaPlex has no gradient-checkpointing flag: wrap each layer's forward (instance attribute,
+    so parameter names are unchanged). Non-reentrant, so LoRA params get grads even when the layer
+    input does not require grad (frozen embeddings)."""
+    for layers in (lm.transformer.layers, lm.depformer.layers):
+        for layer in layers:
+            f = layer.forward
+
+            def fwd(x, *a, _f=f, **k):
+                if torch.is_grad_enabled():
+                    return checkpoint(_f, x, *a, use_reentrant=False, **k)
+                return _f(x, *a, **k)
+
+            layer.forward = fwd
+
+
+def forward_train_agent(lm, codes: torch.Tensor, dep_steps: int = 8) -> LMOutput:
+    """PersonaPlex LMModel.forward_train restricted to the first `dep_steps` depformer steps
+    (same code path otherwise; see moshi/models/lm.py forward_train / forward_depformer_training)."""
+    B, K, T = codes.shape
+    initial = lm._get_initial_token().expand(B, -1, -1)
+    delayed = _delay_sequence(lm.delays, codes, initial)
+    delayed = torch.cat([initial, delayed], dim=2)
+    transformer_out, text_logits = lm.forward_codes(delayed[:, :, :-1])
+    seq = delayed[:, :, 1:]
+    inputs = []
+    for cb in range(dep_steps):
+        t_in = lm.depformer_in[cb](transformer_out)
+        if cb == 0:
+            tok = lm.depformer_text_emb(seq[:, 0])
+        else:
+            tok = lm.depformer_emb[cb - 1](seq[:, cb + lm.audio_offset - 1])
+        inputs.append(tok + t_in)
+    dep_in = torch.stack(inputs, 2).view(B * T, dep_steps, -1)
+    dep_out = lm.depformer(dep_in)
+    logits = torch.stack([lm.linears[cb](dep_out[:, cb]).view(B, T, -1) for cb in range(dep_steps)], 1)
+    a0 = lm.audio_offset
+    logits, mask = _undelay_sequence(lm.delays[a0:a0 + dep_steps], logits, fill_value=float("NaN"))
+    mask &= codes[:, a0:a0 + dep_steps] != lm.zero_token_id
+    text_logits, text_mask = _undelay_sequence(lm.delays[:1], text_logits, fill_value=float("NaN"))
+    text_mask &= codes[:, :1] != lm.zero_token_id
+    return LMOutput(logits, mask, text_logits, text_mask)
+
+
+def prefix_keep_mask(prefix_len: torch.Tensor, T: int) -> torch.Tensor:
+    """[B, 1, T] bool, False over each sample's prompt prefix."""
+    ar = torch.arange(T, device=prefix_len.device)
+    return (ar[None, :] >= prefix_len[:, None])[:, None, :]
+
+
+def masked_losses(out: LMOutput, codes, prefix_len, first_cb_mult, text_padding_weight, text_pad_ids,
+                  dep_steps: int = 8):
+    """moshi-finetune's compute_loss_with_mask math (text and audio terms, each normalised by its
+    weight sum, total = text + audio), with the prompt prefix masked and audio limited to the
+    dep_steps agent codebooks (rows 1..dep_steps). Also returns per-codebook unweighted CE for logging."""
+    T = codes.shape[-1]
+    keep = prefix_keep_mask(prefix_len, T)
+    tmask = out.text_mask & keep
+    amask = out.mask & keep
+    # text
+    tgt = torch.where(tmask, codes[:, :1], torch.zeros_like(codes[:, :1]))
+    w = tmask.float()
+    for i in text_pad_ids:
+        w[tgt == i] *= text_padding_weight
+    ce_t = nn.functional.cross_entropy(out.text_logits.reshape(-1, out.text_logits.size(-1)).float(),
+                                       tgt.reshape(-1), reduction="none")
+    wv = w.reshape(-1)
+    ce_t = torch.where(wv > 0, ce_t * wv, torch.zeros_like(ce_t))
+    text_loss = ce_t.sum() / wv.sum()
+    # audio (agent rows only)
+    acodes = codes[:, 1:1 + dep_steps]
+    tgt = torch.where(amask, acodes, torch.zeros_like(acodes))
+    w = amask.float()
+    w[:, 0] *= first_cb_mult
+    ce_a = nn.functional.cross_entropy(out.logits.reshape(-1, out.logits.size(-1)).float(),
+                                       tgt.reshape(-1), reduction="none")
+    wv = w.reshape(-1)
+    ce_aw = torch.where(wv > 0, ce_a * wv, torch.zeros_like(ce_a))
+    audio_loss = ce_aw.sum() / wv.sum()
+    with torch.no_grad():
+        m = amask.float()
+        ce = torch.where(m.reshape(-1) > 0, ce_a, torch.zeros_like(ce_a)).view_as(m)
+        per_cb = ce.sum(dim=(0, 2)) / m.sum(dim=(0, 2)).clamp(min=1)
+        stats = {"text": text_loss.detach(), "cb1": per_cb[0], "cb2_8": per_cb[1:].mean(),
+                 "n_real_tokens": tmask.sum() + amask.sum()}
+    return text_loss + audio_loss, text_loss, audio_loss, stats
+
+
+@torch.no_grad()
+def adapter_state_dict(lm, ft_embed: bool, dep_steps: int, dtype=torch.bfloat16) -> dict:
+    """Keys: '<PP param name>.lora_A' [n,r,in], '<PP param name>.lora_B' [n,out,r] (n = 1 or per-step
+    block count), plus full embedding tables under their PP names when ft_embed."""
+    sd = {}
+    for mname, mod in lm.named_modules():
+        if parametrize.is_parametrized(mod):
+            for attr, plist in mod.parametrizations.items():
+                lw = plist[0]
+                key = f"{mname}.{attr}" if mname else attr
+                sd[key + ".lora_A"] = lw.lora_A.detach().to(dtype).cpu().contiguous()
+                sd[key + ".lora_B"] = lw.lora_B.detach().to(dtype).cpu().contiguous()
+    if ft_embed:
+        for n, p in lm.named_parameters():
+            if is_trainable_emb(n, dep_steps):
+                sd[n] = p.detach().to(dtype).cpu().contiguous()
+    return dict(sorted(sd.items()))
