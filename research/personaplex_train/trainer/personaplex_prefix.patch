+def parse_eval_sets(spec: str) -> list[tuple[str, str]]:
+    """data.eval_data -> [(split name, manifest path), ...] in the given order.
+      "/path/a.jsonl"                          -> [("eval", "/path/a.jsonl")]   (single manifest, as before)
+      "val=/path/a.jsonl,control=/path/b.jsonl" -> [("val", ...), ("control", ...)]
+    Names: [a-z0-9_]+, unique. Every set is evaluated at every eval step with the same evaluate()."""
+    spec = (spec or "").strip()
+    assert spec, "empty eval_data"
+    if "=" not in spec:
+        return [("eval", spec)]
+    sets: list[tuple[str, str]] = []
+    for item in spec.split(","):
+        item = item.strip()
+        assert "=" in item, f"eval_data item {item!r}: expected name=path (all items named when one is)"
