+VOICE_FOR_GENDER = {"f": "NATF2", "m": "NATM1"}
+
+
+class PersonaPlexPrefix:
+    """Builds the PersonaPlex system-prompt prefix as training codes [1, 17, P].
+
+    Mirrors LMGen.step_system_prompts (moshi/models/lm.py) as used by moshi/offline.py and server.py
+    (audio_silence_frame_cnt = int(0.5 * 12.5) = 6):
+      voice prompt (51 frames): text = PAD(3), agent rows = voice Mimi codes, user rows = SINE_TOKENS
+      silence (6):              text = PAD,    agent = SILENCE_TOKENS,        user = SINE_TOKENS
+      role prompt (len(ids)):   text = ids,    agent = SILENCE_TOKENS,        user = SINE_TOKENS
+      silence (6):              text = PAD,    agent = SILENCE_TOKENS,        user = SINE_TOKENS
+    ids = tokenizer.encode(wrap_with_system_tags(role_prompt)) exactly as offline.py.
+    Training codes[t] equals LMGen frame t+1 (LMGen frame 0 is overwritten by the initial token and
+    never seen), so the voice part is vf[:, 1:52] of the codes recovered from the NATF2/NATM1 .pt
+    replays (trainer/voice_codes/*.frames.pt; bit-exact re-embedding on 51/51 columns).
+    """
+
+    def __init__(self, tokenizer, voice_codes_dir: str, text_padding: int = 3, silence_frames: int = 6):
+        self.tokenizer = tokenizer
+        self.text_padding = text_padding
+        self.silence_frames = silence_frames
+        self.voice_codes = {}
+        for v in ("NATF2", "NATM1"):
+            vf = torch.load(os.path.join(voice_codes_dir, f"{v}.frames.pt"))["vf"]
+            assert vf.shape == (8, 52), vf.shape
+            self.voice_codes[v] = vf[:, 1:52].long()
+        self.silence = torch.as_tensor(SILENCE_TOKENS, dtype=torch.long).view(8, 1)
+        self.sine = torch.as_tensor(SINE_TOKENS, dtype=torch.long).view(8, 1)
+        self._cache: dict = {}
+
+    @staticmethod
+    def voice_of(data: dict) -> str:
+        v = data.get("voice_prompt")
+        if v is None:
+            v = VOICE_FOR_GENDER[data["agent_gender"]]
+        v = os.path.splitext(os.path.basename(v))[0]
+        assert v in VOICE_FOR_GENDER.values(), f"unsupported voice prompt {v}"
+        return v
+
+    def prompt_ids(self, role_prompt: str) -> list[int]:
+        ids = self.tokenizer.encode(wrap_with_system_tags(role_prompt))
+        # SentencePiece unk id (0) == EPAD: a non-ASCII char would silently become EPAD.
+        if 0 in ids:
+            raise ValueError(f"role prompt has {ids.count(0)} unknown tokens (id 0 == EPAD): {role_prompt!r}")
+        return ids
+
+    def __call__(self, role_prompt: str, voice: str) -> torch.Tensor:
+        key = (role_prompt, voice)
+        if key not in self._cache:
+            ids = self.prompt_ids(role_prompt)
+            vc = self.voice_codes[voice]
+            nv, ns, nt = vc.shape[-1], self.silence_frames, len(ids)
+            P = nv + ns + nt + ns
+            text = torch.full((1, P), self.text_padding, dtype=torch.long)
+            text[0, nv + ns: nv + ns + nt] = torch.tensor(ids, dtype=torch.long)
+            agent = torch.cat([vc, self.silence.expand(8, ns + nt + ns)], dim=1)
+            user = self.sine.expand(8, P)
+            self._cache[key] = torch.cat([text, agent, user], dim=0)[None]  # [1, 17, P]
+        return self._cache[key]
+
